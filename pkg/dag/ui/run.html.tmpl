<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{.Title}}</title><style>
:root{color-scheme:light dark;--bg:#f5f7fb;--card:#fff;--ink:#18202b;--muted:#657184;--line:#dce2eb;--accent:#315efb;--warn:#b55300;--bad:#c0392b;--good:#1e7a46}
@media(prefers-color-scheme:dark){:root{--bg:#11151b;--card:#1a2029;--ink:#edf2f7;--muted:#9da8b8;--line:#303947;--accent:#8aa4ff;--warn:#ffb45f;--bad:#ff7a6b;--good:#5fd39a}}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.45 ui-sans-serif,system-ui,sans-serif}
main{max-width:1500px;margin:auto;padding:clamp(16px,3vw,40px)}h1{margin:0;font-size:1.3rem}
a{color:var(--accent)}
.sub{color:var(--muted);margin:.3rem 0 1.4rem;overflow-wrap:anywhere}
.summary{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-bottom:18px}
.metric{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:14px}
.metric b{display:block;font-size:1.4rem;overflow-wrap:anywhere}
h2{font-size:1rem;margin:22px 0 10px}
.scroll{overflow-x:auto}
table{border-collapse:collapse;width:100%}
th,td{text-align:left;padding:8px;border-bottom:1px solid var(--line);vertical-align:top}
th{color:var(--muted);font-size:.75rem;text-transform:uppercase;letter-spacing:.04em}
.graph td{width:1%;white-space:nowrap}
.node{border-left:3px solid var(--accent);border-radius:6px;padding:7px 9px;margin:4px 0;background:var(--card)}
.node .nm{font-weight:600;overflow-wrap:anywhere}
.node .meta{font-size:.8rem;color:var(--muted)}
.s-failed{border-color:var(--bad)}.s-skipped,.s-condition-skipped{border-color:var(--warn)}
.s-done{border-color:var(--good)}.s-up-to-date{border-color:var(--muted)}
.s-running{border-color:var(--accent);animation:pulse 1.1s ease-in-out infinite}
.s-pending{border-color:var(--line)}
@keyframes pulse{50%{opacity:.55}}
.pill{display:inline-block;padding:1px 7px;border-radius:99px;font-size:.75rem;border:1px solid var(--line)}
.pill.bad{color:var(--bad);border-color:var(--bad)}.pill.good{color:var(--good);border-color:var(--good)}
.pill.live{color:var(--accent);border-color:var(--accent)}
code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.85rem;overflow-wrap:anywhere}
.empty{color:var(--muted)}
#logpane{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:12px;margin:0;
  max-height:22rem;overflow:auto;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.82rem;
  white-space:pre-wrap;overflow-wrap:anywhere;color:var(--ink)}
#logwho{font-weight:400;font-size:.85rem}
@media(max-width:700px){main{padding:14px}}
</style></head><body><main>
{{if .Live}}<p class="sub"><a href="/">&larr; all runs</a></p>{{end}}
<h1>{{.Title}}</h1>
<p class="sub"><code>{{.Run.File}}</code></p>
<section class="summary">
  <div class="metric"><b id="verdict">{{if .Live}}<span class="pill live">running</span>{{else if .Run.Failed}}<span class="pill bad">FAILED</span>{{else}}<span class="pill good">ok</span>{{end}}</b>result</div>
  <div class="metric"><b id="elapsed">{{dur .Run.DurationMS}}</b>elapsed</div>
  <div class="metric"><b>{{len .Run.Tasks}}</b>targets</div>
  <div class="metric"><b>{{ts .Run.StartedAt}}</b>started</div>
</section>

{{if .Grid}}
<h2>Graph</h2>
<div class="scroll"><table class="graph"><thead><tr>{{range .Levels}}<th>L{{.}}</th>{{end}}</tr></thead><tbody>
{{range .Grid}}<tr>{{range .}}<td>{{with .Task}}<div class="node s-{{cls .Status}}" data-task="{{.Name}}"><div class="nm">{{.Name}}</div><div class="meta"><span data-field="status">{{.Status}}</span> · <span data-field="dur">{{dur .DurationMS}}</span></div></div>{{else}}<span class="empty">·</span>{{end}}</td>{{end}}</tr>{{end}}
</tbody></table></div>
{{end}}

{{if .Live}}
<h2>Output <span class="empty" id="logwho">— waiting for a target to start</span></h2>
<pre id="logpane">·</pre>
{{end}}

<h2>Targets</h2>
<div class="scroll"><table><thead><tr><th>Target</th><th>Status</th><th>Duration</th><th>Exit</th><th>Artifacts</th><th>Logs</th></tr></thead><tbody>
{{range .Tasks}}<tr data-task="{{.Name}}">
  <td><code>{{.Name}}</code></td>
  <td data-field="status">{{.Status}}</td>
  <td data-field="dur">{{dur .DurationMS}}</td>
  <td data-field="exit">{{.ExitCode}}</td>
  <td>{{if .Artifacts}}{{range .Artifacts}}<code>{{.}}</code><br>{{end}}{{else}}<span class="empty">—</span>{{end}}</td>
  <td>{{if .Logs}}{{range .Logs}}{{if $.Live}}<a href="/log?doc={{$.DocKey}}&run={{$.RunID}}&path={{.}}"><code>{{.}}</code></a><br>{{else}}<code>{{.}}</code><br>{{end}}{{end}}{{else}}<span class="empty">—</span>{{end}}</td>
</tr>{{end}}
</tbody></table></div>

<p class="sub">run <code>{{.Run.RunID}}</code> · generated by bashy dag</p>
{{if .Live}}<script>
// Live update over SSE. The page is fully rendered server-side first, so it is
// readable and correct with scripting disabled; this only keeps it fresh.
(function () {
  var src = new EventSource({{.StreamURL}});
  function set(task, field, value) {
    document.querySelectorAll('[data-task]').forEach(function (el) {
      if (el.dataset.task !== task) return;
      var t = el.querySelector('[data-field="' + field + '"]');
      if (t) t.textContent = value;
      if (field === "status") el.className = el.className.replace(/s-[a-z-]+/, "s-" + value);
    });
  }
  // Tail the running target's output. Status changes a handful of times in a
  // long run; the output is what you actually watch.
  var pane = document.getElementById("logpane");
  var who = document.getElementById("logwho");
  var tail = null, lines = [];
  var MAX = 500; // keep the DOM bounded when a stage is chatty
  function follow(task, path) {
    if (tail) tail.close();
    lines = [];
    pane.textContent = "";
    who.textContent = "— " + task;
    tail = new EventSource({{.LogTailBase}} + "&path=" + encodeURIComponent(path));
    tail.onmessage = function (m) {
      var atBottom = pane.scrollHeight - pane.scrollTop - pane.clientHeight < 40;
      lines.push(JSON.parse(m.data).line);
      if (lines.length > MAX) lines = lines.slice(-MAX);
      pane.textContent = lines.join("\n");
      if (atBottom) pane.scrollTop = pane.scrollHeight; // don't yank a reader who scrolled up
    };
  }
  src.onmessage = function (m) {
    var ev = JSON.parse(m.data);
    if (ev.t === "task.start") {
      set(ev.task, "status", "running");
      if (ev.log) follow(ev.task, ev.log);
    }
    if (ev.t === "task.end") {
      set(ev.task, "status", ev.status);
      set(ev.task, "dur", (ev.ms || 0) + "ms");
      set(ev.task, "exit", ev.exit || 0);
    }
    if (ev.t === "run.end") {
      src.close();
      if (tail) tail.close();
      // The finished run has artifacts and log paths the event stream does not
      // carry; reload once to pick up the authoritative report.
      location.reload();
    }
  };
})();
</script>{{end}}
</main></body></html>
