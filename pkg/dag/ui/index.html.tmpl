<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>dag runs</title>{{if .Live}}<meta http-equiv="refresh" content="5">{{end}}<style>
:root{color-scheme:light dark;--bg:#f5f7fb;--card:#fff;--ink:#18202b;--muted:#657184;--line:#dce2eb;--accent:#315efb;--warn:#b55300;--bad:#c0392b;--good:#1e7a46}
@media(prefers-color-scheme:dark){:root{--bg:#11151b;--card:#1a2029;--ink:#edf2f7;--muted:#9da8b8;--line:#303947;--accent:#8aa4ff;--warn:#ffb45f;--bad:#ff7a6b;--good:#5fd39a}}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.45 ui-sans-serif,system-ui,sans-serif}
main{max-width:1500px;margin:auto;padding:clamp(16px,3vw,40px)}h1{margin:0;font-size:1.3rem}
a{color:var(--accent)}
.sub{color:var(--muted);margin:.3rem 0 1.4rem}
.scroll{overflow-x:auto}
table{border-collapse:collapse;width:100%}
th,td{text-align:left;padding:8px;border-bottom:1px solid var(--line);vertical-align:top;white-space:nowrap}
th{color:var(--muted);font-size:.75rem;text-transform:uppercase;letter-spacing:.04em}
td.file{white-space:normal;overflow-wrap:anywhere;color:var(--muted)}
.pill{display:inline-block;padding:1px 7px;border-radius:99px;font-size:.75rem;border:1px solid var(--line)}
.pill.bad{color:var(--bad);border-color:var(--bad)}.pill.good{color:var(--good);border-color:var(--good)}
.pill.live{color:var(--accent);border-color:var(--accent)}
code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.85rem}
.empty{color:var(--muted)}
@media(max-width:700px){main{padding:14px}}
</style></head><body><main>
<h1>dag runs</h1>
<p class="sub">{{len .Runs}} recorded · {{.Live}} in flight{{if .Live}} · refreshing{{end}}</p>
{{if .Runs}}
<div class="scroll"><table><thead><tr><th>Result</th><th>Progress</th><th>Targets</th><th>Started</th><th>Elapsed</th><th>File</th></tr></thead><tbody>
{{range .Runs}}<tr>
  <td><a href="/run?doc={{.DocKey}}&run={{.RunID}}">{{if .Live}}<span class="pill live">running</span>{{else if .Failed}}<span class="pill bad">FAILED</span>{{else}}<span class="pill good">ok</span>{{end}}</a></td>
  <td>{{.Done}}/{{.Total}}{{if .FailedN}} · {{.FailedN}} failed{{end}}</td>
  <td><code>{{join .Targets}}</code></td>
  <td>{{ts .StartedAt}}</td>
  <td>{{dur .DurationMS}}</td>
  <td class="file">{{.File}}</td>
</tr>{{end}}
</tbody></table></div>
{{else}}
<p class="empty">No runs recorded yet. Run <code>bashy dag &lt;target&gt;</code> in any terminal and it will appear here.</p>
{{end}}
</main></body></html>
