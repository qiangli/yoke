  {
    "path": "auth",
    "type": "string",
    "description": "auth tier: system (default), public or custom"
  },
  {
    "path": "icon",
    "type": "string",
    "description": "SVG path data on a 24 grid, or one emoji"
  },
  {
    "path": "kind",
    "type": "string",
    "description": "always app"
  },
  {
    "path": "label",
    "type": "string",
    "description": "tile label; default the name"
  },
  {
    "path": "login_path",
    "type": "string",
    "description": "custom auth only: app-relative login path"
  },
  {
    "path": "name",
    "type": "string",
    "description": "app name; also its mount (/\u003cname\u003e/) — one path segment"
  },
  {
    "path": "port",
    "type": "int",
    "description": "proxy only: loopback port the app listens on; the console proxies /\u003cname\u003e/ to it"
  },
  {
    "path": "shaping",
    "type": "object",
    "description": "trusted shaping kind, build/test argv and service unit"
  },
  {
    "path": "shaping.build",
    "type": "[]string",
    "description": "trusted build argv; {output} is required for cli/service"
  },
  {
    "path": "shaping.build.\u003cindex\u003e",
    "type": "string",
    "description": "list element"
  },
  {
    "path": "shaping.kind",
    "type": "string",
    "description": "web (default), cli or service"
  },
  {
    "path": "shaping.service",
    "type": "string",
    "description": "service kind only: existing container-backed service unit"
  },
  {
    "path": "shaping.test",
    "type": "[]string",
    "description": "trusted test argv; optional {artifact} and {revision}"
  },
  {
    "path": "shaping.test.\u003cindex\u003e",
    "type": "string",
    "description": "list element"
  },
  {
    "path": "source",
    "type": "string",
    "description": "shaped/site only: absolute source path; a site stays linked to its live directory"
  },
  {
    "path": "start",
    "type": "[]string",
    "description": "argv shown as the start hint when the app is down (never run by the console)"
  },
  {
    "path": "start.\u003cindex\u003e",
    "type": "string",
    "description": "list element"
  },
  {
    "path": "tip",
    "type": "string",
    "description": "tile tooltip"
  },
  {
    "path": "type",
    "type": "string",
    "description": "app type: proxy (default, a loopback server), shaped (versioned source), or site (live static directory)"
  }
