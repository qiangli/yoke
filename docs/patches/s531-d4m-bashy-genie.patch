From cd1aa1aa41f0290215ae248c8bf1136ac3f992ef Mon Sep 17 00:00:00 2001
From: agent-weave-issue-713 <agent-weave-issue-713@ycode.local>
Date: Thu, 29 Oct 2026 11:10:18 -0700
Subject: [PATCH] genie: resolve shared models from live door grants

Sprint: #531
Story: #2928
Story-ID: 333c70de59cf

diff --git a/internal/agentos/genie_external.go b/internal/agentos/genie_external.go
index dfa56cb1..c686ccff 100644
--- a/internal/agentos/genie_external.go
+++ b/internal/agentos/genie_external.go
@@ -40,0 +41 @@ type genieExternal struct {
+	SharedDoor                  bool
@@ -46,0 +48,10 @@ func resolveGenieExternal(name string) (genieExternal, bool, error) {
+	// Door sources precede legacy YAML entries so a copied key cannot shadow a
+	// freshly imported grant. Resolve on every invocation, including in WSL.
+	if m, ok, err := broker.ResolveDoorModel(context.Background(), name); ok {
+		if err != nil {
+			return genieExternal{}, true, err
+		}
+		return genieExternal{Name: name, ModelID: m.ModelID, BaseURL: m.BaseURL,
+			Key: m.Key, Context: genieContextFallback, SharedDoor: true}, true, nil
+	}
+
@@ -162,0 +174,3 @@ func (g genieExternal) viaDoor() bool {
+	if g.SharedDoor {
+		return false
+	}
diff --git a/internal/agentos/genie_shared_door_test.go b/internal/agentos/genie_shared_door_test.go
new file mode 100644
index 00000000..08b40b34
--- /dev/null
+++ b/internal/agentos/genie_shared_door_test.go
@@ -0,0 +1,54 @@
+package agentos
+
+import (
+	"context"
+	"fmt"
+	"github.com/qiangli/yoke/pkg/broker"
+	"github.com/qiangli/yoke/pkg/broker/door"
+	"github.com/qiangli/yoke/pkg/fleet"
+	"testing"
+)
+
+func TestGenieSharedDoorSource(t *testing.T) {
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	t.Setenv("USERPROFILE", home)
+	t.Setenv("BASHY_HOME", "")
+	t.Setenv("BASHY_FLEET_DIR", t.TempDir())
+	t.Setenv("OPENAI_API_KEY", "")
+	t.Setenv("OPENAI_BASE_URL", "")
+	t.Setenv("DRAGON_DOOR_API_KEY", "stale")
+	// An old manually registered alias must not strand its copied credential.
+	if err := fleet.New().SaveModel(fleet.Model{Name: "dragon-door-codex-gpt6-sol", Kind: fleet.ModelKindAPI, Provider: "openai-compat", BaseURL: "https://stale.test/v1", APIKeyRef: "dragon-door"}); err != nil {
+		t.Fatal(err)
+	}
+	grant := broker.DoorGrant{Schema: broker.GrantSchemaVersion, Door: "dragon", Peer: "elephant", CloudboxURL: "https://example.test/app/llm"}
+	for _, key := range []string{"bpeer_first", "bpeer_rotated"} {
+		grant.Credential = key
+		if err := broker.SaveDoorGrant(grant); err != nil {
+			t.Fatal(err)
+		}
+		for _, name := range []string{"codex-gpt6-sol@dragon", "dragon-door-codex-gpt6-sol"} {
+			g, ok, err := resolveGenieExternal(name)
+			if err != nil || !ok {
+				t.Fatalf("%s: ok=%v err=%v", name, ok, err)
+			}
+			if g.ModelID != "codex-gpt6-sol" || g.Key != key || g.BaseURL != grant.CloudboxURL+"/k/"+key+"/v1" || g.Context <= 0 {
+				t.Fatal("wrong endpoint, model, context or stale key")
+			}
+		}
+	}
+	if _, ok, err := resolveGenieExternal("m@missing"); !ok || err == nil {
+		t.Fatalf("missing door fell through: ok=%v err=%v", ok, err)
+	}
+}
+
+func TestGenieSharedDoorNeverStartsLocalServer(t *testing.T) {
+	old := genieEnsureDoor
+	t.Cleanup(func() { genieEnsureDoor = old })
+	genieEnsureDoor = func(context.Context) error { t.Fatal("started local server for shared door"); return nil }
+	g := genieExternal{SharedDoor: true, BaseURL: fmt.Sprintf("http://127.0.0.1:%d/v1", door.Port())}
+	if err := g.prepare(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+}
